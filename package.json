{
  "name": "forth-sight",
  "displayName": "forth-sight",
  "description": "A simple syntax highlighter to make Forth code easier to read.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forth-sight.helloWorld",
        "title": "forth-sight: Hallo Welt anzeigen"
      }
    ],
    "configuration": {
      "title": "forth-sight",
      "properties": {
        "forth-sight.greeting": {
          "type": "string",
          "default": "Hallo aus forth-sight!",
          "description": "Begrüßungstext, der beim Ausführen des Befehls angezeigt wird."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
