{
  "name": "forth-custom-syntax",
  "displayName": "Forth Custom Syntax",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "forth",
        "aliases": [
          "Forth",
          "forth"
        ],
        "extensions": [
          ".fs",
          ".fth",
          ".4th",
          ".f",
          ".seq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "forth",
        "scopeName": "source.forth",
        "path": "./syntaxes/forth.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
