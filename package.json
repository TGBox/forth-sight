{
  "name": "forth-sight",
  "displayName": "Forth Sight",
  "description": "A simple syntax highlighter and code navigation extension to make Forth code easier to read.",
  "version": "0.3.0",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "forth",
        "aliases": [
          "Forth",
          "forth"
        ],
        "extensions": [
          ".fs",
          ".fth",
          ".4th",
          ".f",
          ".seq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "forth",
        "scopeName": "source.forth",
        "path": "./syntaxes/forth.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
